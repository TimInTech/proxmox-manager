---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarkdownIt from 'markdown-it';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
const english = readFileSync(resolve(process.cwd(), '../README.md'), 'utf8');
const german = readFileSync(resolve(process.cwd(), '../README.de.md'), 'utf8');
// Keep the complete upstream reference while omitting embedded third-party images and raw HTML.
function prepare(source) {
  return source.replace(/\]\((README(?:\.de)?\.md|docs\/[^)]+|LICENSE)\)/g, (_, path) => `](https://github.com/TimInTech/proxmox-manager/blob/main/${path})`);
}
const md = new MarkdownIt({ html: true, linkify: false, typographer: false });
md.renderer.rules.image = () => '';
md.renderer.rules.html_block = () => '';
md.renderer.rules.html_inline = () => '';
const render = text => md.render(prepare(text));
const sections = [...english.matchAll(/^## (.+)$/gm)].map((match, i, all) => ({title: match[1], id: `ref-${i + 1}`, content: english.slice(match.index, all[i + 1]?.index ?? english.length)}));
---
<BaseLayout title="Anleitung und Befehlsreferenz"><div class="wrap"><section class="hero"><p class="eyebrow">Dokumentation</p><h1>Installieren. Bedienen. Prüfen.</h1><p class="lead">Deutscher Einstieg und vollständige Befehls- und Konfigurationsreferenz aus den Repository-READMEs.</p></section><div class="docs"><aside class="toc" aria-label="Inhaltsverzeichnis"><a href="#deutsch">Deutsch</a>{sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</aside><div class="prose"><section id="deutsch" set:html={render(german)}></section>{sections.map(section => <section id={section.id} set:html={render(section.content)}></section>)}</div></div></div></BaseLayout>
