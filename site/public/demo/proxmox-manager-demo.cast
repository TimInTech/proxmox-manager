[15.6752, "o", "\u001b[39m\u001b(B\u001b[0;7m> Storage, Dateisysteme, Inodes\u001b(B\u001b[m    Diagnose: Zeigt Speicher, Dateisysteme und\u001b[4;3HSMART und Fehlerverlauf\u001b[4;36HInodes des Hosts.\u001b[5;3HTRIM-Zeitplanung, Kernel, Backu\u001b[6;3HCommunity PVE-Werkzeuge (8)\u001b[36GEnter startet die Diagnose.\u001b[7;3HHerkunft und Aktualit\u00e4tsstatus\r\u001b[22d\u001b[36mZeilen 1\u20134 von 4\r\u001b[23d\u2191\u2193 Auswahl | Enter | PgUp/PgDn | Esc | q Ende\r\u001b[24dBereit\u001b[39m\u001b(B\u001b[m"]
[17.377, "o", "\r\u001b[3d  Storage, Dateisysteme, Inodes\u001b[3;46HLiest SMART-Zustand und speichert\r\u001b[4d\u001b(B\u001b[0;7m> SMART und Fehlerverlauf\u001b[4;36H\u001b(B\u001b[meinen lokalen Vergleichsstand.\u001b[6;36HQuelle: Eigene Implementierung\u001b[24;7H\u001b[3;46HZeigt TRIM-Zeitplanung, Kernel\u001b[K\r\u001b[4d  SMART und Fehlerverlauf\u001b[4;36Hund Backup-Speicher.\u001b[K\r\u001b[5d\u001b(B\u001b[0;7m> TRIM-Zeitplanung, Kernel, Backu\u001b[24;7H\u001b(B\u001b[m\u001b[3;36HCommunity-Werkzeuge\u001b[K\u001b[4;36HEnter \u00f6ffnet diese Ansicht.\r\u001b[5d  TRIM-Zeitplanung, Kernel, Backu\r\u001b[6d\u001b(B\u001b[0;7m> Community PVE-Werkzeuge (8)\u001b(B\u001b[m\u001b[K\u001b[22;10H\u001b[36m2 von 2\u001b[24;7H\u001b[39m\u001b(B\u001b[m"]
[17.3952, "o", "\u001b[1;24H\u001b(B\u001b[0;1m\u001b[36mCOMMUNITY PVE-WERKZEUGE\r\u001b[3d\u001b[39m\u001b(B\u001b[0;7m> PVE Disk Health Tool\u001b(B\u001b[m             SMART-\u00dcbersicht; bietet optional einen\u001b[4;3HPVE LXC Filesystem Trim\u001b[4;36Hkurzen SMART-Selbsttest an\u001b[5;3HPVE LXC Cleaner\u001b[K\r\u001b[6d  PVE Kernel Clean           \u001b[36GRisiko / Auswirkung:\u001b[7;3HPVE Clean Orphaned LVM           Nur Diagnose bis auf Nachfrage. Kann\u001b[8;3HPVE Host Backup\u001b[8;36Hsmartmontools und nvme-cli per APT\u001b[9;3HPVE CPU Scaling Governor\u001b[9;36Hinstallieren.\u001b[10;3HPVE LXC Updater\u001b[11;3H\u2190 Zur\u00fcck zum Wartungsmen\u00fc\u001b[11;36HJeder Start pr\u00fcft den aktuellen Upstream\u001b[12;36Hund die Skript-Pr\u00fcfsumme.\u001b[13;36HDie optionale Upstream-Telemetrie wird\u001b[14;36Hnicht geladen.\u001b[22;10H\u001b[36m12 von 12\r\u001b[24dCommunity Scripts: 8 gepr\u00fcfte Host-Werkzeuge\u001b[39m\u001b(B\u001b[m"]
[23.2477, "o", "\u001b[1;24H\u001b(B\u001b[0;1m\u001b[36mWartung\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[3d  Storage, Dateisysteme, Inodes    Community-Werkzeugmen\u00fc geschlossen.\u001b[K\u001b[4;3HSMART und Fehlerverlauf\u001b[K\u001b[5;3HTRIM-Zeitplanung, Kernel, Backu\r\u001b[6d\u001b(B\u001b[0;7m> Community PVE-Werkzeuge (8)\u001b(B\u001b[m\u001b[K\u001b[7;3HHerkunft und Aktualit\u00e4tsstatus\u001b[K\r\u001b[8d\u001b[K\u001b[9d\u001b[K\u001b[10d\u001b[K\u001b[11d\u001b[K\u001b[12d\u001b[K\u001b[13d\u001b[K\u001b[14d\u001b[K\u001b[22;11H\u001b[36m von 1\u001b[39m\u001b(B\u001b[m\u001b[K\r\u001b[24d\u001b[36mBereit\u001b[39m\u001b(B\u001b[m\u001b[K"]
