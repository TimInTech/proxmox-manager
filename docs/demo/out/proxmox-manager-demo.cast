[15.7268, "o", "\u001b[39;49m\u001b[37m\u001b[40m\u001b[H\u001b[2J\u001b(B\u001b[0;1m\u001b[39;49m\u001b[37m\u001b[40mpman Wartung | HOST\u001b[2;45HDetails\r\u001b[3d"]
[15.7272, "o", "\u001b(B\u001b[0;7m\u001b[39;49m\u001b[37m\u001b[40m> Storage, Dateisysteme, Inodes          \u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u2502 Diagnose: Zeigt Speicher, Dateisysteme und Inodes des\u001b[4;3HSMART und Fehlerverlauf\u001b[4;43H\u2502 Hosts.\u001b[5;3HTRIM-Zeitplanung, Kernel, Backups\u001b[43G\u2502\u001b[6;3HProxmox VE Helper-Scripts (8) \u25b8\u001b[6;43H\u2502 Enter startet die Diagnose.\u001b[7;3HHerkunft und Aktualit\u00e4tsstatus\u001b[7;43H\u2502\u001b[8d\b\u2502\u001b[9d\b\u2502\u001b[10d\b\u2502\u001b[11d\b\u2502\u001b[12d\b\u2502\u001b[13d\b\u2502\u001b[14d\b\u2502\u001b[15d\b\u2502\u001b[16d\b\u2502\u001b[17d\b\u2502\u001b[18d\b\u2502\u001b[19d\b\u2502\u001b[20d\b\u2502\u001b[21d\b\u2502\u001b[22d\b\u2502\u001b[23d\b\u2502\r\u001b[25d\u2191\u2193 Auswahl | Enter | PgUp/PgDn | Esc | q Ende\r\u001b[26d\u001b(B\u001b[0;1m\u001b[39;49m\u001b[37m\u001b[40mBereit\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[17.4283, "o", "\r\u001b[3d  Storage, Dateisysteme, Inodes          \u001b[3;55HLiest SMART-Zustand und speichert einen\u001b[K\r\u001b[4d\u001b(B\u001b[0;7m\u001b[39;49m\u001b[37m\u001b[40m> SMART und Fehlerverlauf                \u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u2502 lokalen Vergleichsstand.\u001b[6;45HQuelle: Eigene Implementierung\u001b[26;7H\u001b[3;55HZeigt TRIM-Zeitplanung, Kernel und\u001b[K\r\u001b[4d  SMART und Fehlerverlauf\u001b[17X\u001b[4;43H\u2502 Backup-Speicher.\u001b[K\r\u001b[5d\u001b(B\u001b[0;7m\u001b[39;49m\u001b[37m\u001b[40m> TRIM-Zeitplanung, Kernel, Backups      \u001b[26;7H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[3;45H\u001b(B\u001b[0;1m\u001b[39;49m\u001b[37m\u001b[40mProxmox VE Helper-Scripts (Community)\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[K\u001b[4;45HFremder Code unter MIT-Lizenz - nicht von pman und nicht\r\u001b[5d  TRIM-Zeitplanung, Kernel, Backups       \u2502 von Proxmox.\r\u001b[6d\u001b(B\u001b[0;7m\u001b[39;49m\u001b[37m\u001b[40m> Proxmox VE Helper-Scripts (8) \u25b8        \u001b[44G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[K\u001b[7d https://community-scripts.org\u001b[9;45HEnter \u00f6ffnet 8 ausgew\u00e4hlte Host-Skripte; gestartet wird\u001b[10;45Herst nach Best\u00e4tigung.\u001b[26;7H"]
